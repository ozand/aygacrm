# ===========================================
# AygaCRM - Environment Configuration
# ===========================================
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Only DATABASE_URL and AUTH_SECRET are strictly required to boot; object
# storage is required for the files/avatars feature; everything else is
# optional and degrades gracefully when unset.

# --- Application ---------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# --- Database (PostgreSQL) — REQUIRED ------------------------------------
DATABASE_URL="postgresql://aygacrm:aygacrm@localhost:5432/aygacrm?schema=public"

# --- Authentication (NextAuth / Auth.js v5) — AUTH_SECRET REQUIRED -------
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"
AUTH_URL="http://localhost:4000"

# Optional OAuth login providers. Set the NEXT_PUBLIC_AUTH_* flag to "1" to
# show the button, and provide the client id/secret. Leave blank to disable.
NEXT_PUBLIC_AUTH_GOOGLE=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_AUTH_GITHUB=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Object storage (S3-compatible, e.g. MinIO) — required for files -----
# The bundled docker-compose stack sets these automatically. For a manual
# setup, point them at any S3-compatible endpoint.
# S3_ENDPOINT        : in-cluster/server-side API address
# S3_PUBLIC_ENDPOINT : address the BROWSER uses for presigned GET URLs
#                      (falls back to S3_ENDPOINT when unset)
# S3_FORCE_PATH_STYLE: "1" for MinIO (path-style), "0" for AWS S3 (vhost)
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="aygacrm"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="1"

# --- Outbound email (SMTP) — optional ------------------------------------
# Single connection URL, e.g. smtp://user:pass@host:587 or smtps://... .
# Unset => reminder emails are silently skipped.
SMTP_URL=""
SMTP_FROM="AygaCRM <noreply@localhost>"

# --- Scheduled jobs / API ------------------------------------------------
# Shared secret required by the cron endpoints (e.g. /api/cron/send-reminders).
CRON_SECRET=""
# Per-token API rate limit (requests/minute). Unset => default.
API_RATE_LIMIT_PER_MINUTE=""

# --- CLI / MCP / ingestion adapters --------------------------------------
# Used by the `aygacrm` CLI, the `aygacrm-mcp` server, and the standalone
# ingestion adapters (e.g. Telegram). AYGACRM_API_URL defaults to
# http://localhost:4000; the token is a bearer API token minted in the app
# (Settings -> API Tokens).
AYGACRM_API_URL="http://localhost:4000"
AYGACRM_API_TOKEN=""

# --- Telegram ingestion adapter — optional -------------------------------
# Bot token from @BotFather; used by `pnpm ingest:telegram`
# (src/ingest/telegram/run.ts) — see docs/integrations/telegram.md.
TELEGRAM_BOT_TOKEN=""
