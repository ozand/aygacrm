# Docker build context = app/ (see app/Dockerfile header comment).
# Keep the context small; only source needed to build/run the image.

node_modules
.next
dist
.turbo

# tests / tooling artifacts — not needed to build or run the image
e2e
test-results
playwright-report
playwright.config.ts
coverage
*.tsbuildinfo
tsc-errors-before.txt
tsc-errors-after.txt
tsc-output.txt
nul

# env & secrets — never bake these into an image
.env
.env.*
!.env.example

# vcs / editor / misc
.git
.gitignore
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# docs not needed inside the image
README.md
