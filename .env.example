# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/monica?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cron Jobs (optional) — protects /api/cron/reminders; call it with
# "Authorization: Bearer $CRON_SECRET" from your scheduler
CRON_SECRET=""

# Reminder notification delivery (optional)
# SMTP_URL: nodemailer connection URL, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=""
SMTP_FROM="Monica CRM <no-reply@localhost>"
# Telegram bot token from @BotFather; channel content = chat id
TELEGRAM_BOT_TOKEN=""

# Show OAuth buttons on the login page (set to 1 only when the matching
# GOOGLE_CLIENT_ID/SECRET or GITHUB_CLIENT_ID/SECRET are configured)
NEXT_PUBLIC_AUTH_GOOGLE=0
NEXT_PUBLIC_AUTH_GITHUB=0

# API rate limiting (per API token, per minute; default 120)
API_RATE_LIMIT_PER_MINUTE=120

# Object storage (MinIO / S3-compatible) for file & photo uploads.
# When unset, uploads fall back to local disk (public/uploads).
S3_ENDPOINT=""
# S3_PUBLIC_ENDPOINT="" # optional: browser-reachable endpoint for presigned URLs; defaults to S3_ENDPOINT
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=1
